{
    "name": "popphp/pop-queue",
    "description": "Pop Queue Component for Pop PHP Framework",
    "keywords": [
        "queue",
        "job",
        "worker",
        "scheduler",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-queue",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/popphp": "^5.0.0-beta.17",
        "popphp/pop-db": "^7.0.0-beta.1",
        "popphp/pop-utils": "^3.0.0-beta.1",
        "laravel/serializable-closure": "^2.0.3",
        "symfony/process": "^7.2|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0"
    },
    "suggest": {
        "ext-redis": "For using the Redis adapter",
        "aws/aws-sdk-php": "For using the Sqs adapter (^3.283.18)"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Queue\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
